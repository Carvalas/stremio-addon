# Copie para .env e ajuste se necessário. Todas as variáveis são opcionais.

# Rede
HOST=0.0.0.0
PORT=7000

# API (pública, usada pelo app Max Net TV)
API_BASE_URL=https://explouddev.com.br
EPG_BASE_URL=https://explouddev.com

# Caches (ms)
CHANNELS_TTL_MS=600000
SEARCH_TTL_MS=300000
EPG_TTL_MS=21600000
EPG_PROGRAMS_TTL_MS=7200000
RULES_TTL_MS=1800000
PROBE_TTL_MS=600000

# Probe de streams diretos
PROBE_TIMEOUT_MS=8000
PLAYER_UA=DVPlayer/35 (Android 9)

# Log
LOG_LEVEL=info

# Catálogo: mostra apenas canais com stream direto confirmado (out/compatible-channels.json)
ONLY_COMPATIBLE=true

# Proxy de headers para fontes HEADER_WORKING (sem JWT/token)
PROXY_ENABLED=true
# URL pública base usada nas URLs do /proxy (e na lista /playlist.m3u).
# Local: pode deixar o default (http://localhost:7000). Para Nuvio em outro
# aparelho ou servidor 24/7, use http://<IP>:7000 ou http://<dominio>:7000.
# PUBLIC_URL=http://localhost:7000
# PROXY_BASE_URL=http://localhost:7000
# PROXY_EXTRA_HOSTS=
PROXY_TIMEOUT_MS=15000
PROXY_MAX_REDIRECTS=5
PROXY_LEARN_TTL_MS=3600000
# Cache de playlists: reload fica rápido e upstream flaky não quebra a reprodução
PROXY_PLAYLIST_CACHE_MS=2500
PROXY_PLAYLIST_STALE_MS=15000
PROXY_RETRY_TIMEOUT_MS=5000
# Playlist mantida "quente" em background enquanto o canal está em uso
PROXY_WARM_REFRESH_MS=2000
PROXY_WARM_IDLE_MS=6000
# Segmentos do MESMO host da playlist (CDN) vão DIRETO ao upstream (UA comum),
# tirando o proxy do caminho pesado. PADRÃO: false — segmentos passam pelo proxy
# (com headers da regra) e o proxy PRÉ-BUSCA os próximos, então o player recebe
# na hora do cache local (importante quando o CDN está lento/variável).
PROXY_DIRECT_SEGMENTS=false
# Pré-busca de segmentos (o proxy baixa o próximo em background e serve na hora)
PROXY_SEGMENT_CACHE_MAX=6
PROXY_PREFETCH_AHEAD=2
PROXY_SEGMENT_MAX_BYTES=26214400
